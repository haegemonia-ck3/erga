OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Comma-separated channel IDs. Threads inherit their parent's access.
DISCORD_CHANNEL_IDS=
# Roles inherit lower tiers: delete roles can also write and read.
# Empty role lists grant no access. Use everyone to allow all channel members.
DISCORD_READ_ROLE_IDS=
# Comma-separated role IDs allowed to request changes. Empty = read-only.
# Set to everyone to let every member in the allowed channels request changes.
DISCORD_WRITE_ROLE_IDS=
DISCORD_DELETE_ROLE_IDS=
# Prefer the existing GitHub App. Install it on the repository first.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
# Alternatively, use a fine-grained repository token.
GITHUB_TOKEN=
# Comma-separated owner/repository names; first is the default.
GITHUB_REPOSITORIES=haegemonia-ck3/Haegemonia_An_Ancient_Odyssey
DATABASE_PATH=data/erga.sqlite
SESSION_TTL_HOURS=168
TURN_TIMEOUT_SECONDS=300
MAX_ACTIVE_TURNS=3
